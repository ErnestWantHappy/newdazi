# 本文件是模板。部署时复制为同目录 judge0.conf，并只在服务器上填入随机密码和令牌。
JUDGE0_TELEMETRY_ENABLE=false
RAILS_ENV=production
RESTART_MAX_TRIES=3
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
SUBMISSION_CACHE_DURATION=0
USE_DOCS_AS_HOMEPAGE=false

# Judge0 API 仅接受平台后端；Docker 端口还会绑定 10.52.1.129，并由宿主机防火墙限制来源。
ALLOW_ORIGIN=
ALLOW_IP=10.52.1.123
AUTHN_HEADER=X-Judge0-Token
AUTHN_TOKEN=REPLACE_WITH_RANDOM_JUDGE0_TOKEN

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD

# 平台 Java 后端还会把每题限制带入请求；这些值是 Judge0 的不可突破上限。
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=10
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=1
WALL_TIME_LIMIT=12
MAX_WALL_TIME_LIMIT=12
MEMORY_LIMIT=131072
MAX_MEMORY_LIMIT=524288
STACK_LIMIT=65536
MAX_STACK_LIMIT=131072
MAX_PROCESSES_AND_OR_THREADS=8
MAX_MAX_PROCESSES_AND_OR_THREADS=8
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=1024
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
REDIRECT_STDERR_TO_STDOUT=false
MAX_EXTRACT_SIZE=0
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false

# 129 当前为 16 线程共享扩展机；10 个执行进程用于消化判题，剩余资源留给 API、CryptPad 和 EMQX。
# “400 并发”指 400 份平台提交可同时进入持久化队列，不等于在单机上同时运行 400 个沙箱。
COUNT=10
MAX_QUEUE_SIZE=512
INTERVAL=0.1
RAILS_MAX_THREADS=8
RAILS_SERVER_PROCESSES=2
SECRET_KEY_BASE=REPLACE_WITH_RANDOM_RAILS_SECRET
