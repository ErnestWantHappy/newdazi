<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.GuideSheetAnswerMapper">

    <resultMap type="BizGuideSheetAnswer" id="BizGuideSheetAnswerResult">
        <result property="answerId"    column="answer_id"    />
        <result property="sheetId"     column="sheet_id"     />
        <result property="studentId"   column="student_id"   />
        <result property="lessonId"    column="lesson_id"    />
        <result property="answerJson"  column="answer_json"  />
        <result property="currentPage" column="current_page" />
        <result property="status"      column="status"       />
        <result property="totalScore"  column="total_score"  />
        <result property="gradingStatus" column="grading_status" />
        <result property="gradingDetail" column="grading_detail" />
        <result property="submitTime"  column="submit_time"  />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="selectBizGuideSheetAnswerVo">
        select answer_id, sheet_id, student_id, lesson_id, answer_json, current_page, status, total_score, grading_status, grading_detail, submit_time, create_time, update_time from biz_guide_sheet_answer
    </sql>

    <select id="selectBizGuideSheetAnswerList" parameterType="BizGuideSheetAnswer" resultMap="BizGuideSheetAnswerResult">
        <include refid="selectBizGuideSheetAnswerVo"/>
        <where>
            <if test="sheetId != null"> and sheet_id = #{sheetId}</if>
            <if test="studentId != null"> and student_id = #{studentId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectBizGuideSheetAnswerByAnswerId" parameterType="Long" resultMap="BizGuideSheetAnswerResult">
        <include refid="selectBizGuideSheetAnswerVo"/>
        where answer_id = #{answerId}
    </select>

    <select id="selectByStudentAndSheet" resultMap="BizGuideSheetAnswerResult">
        <include refid="selectBizGuideSheetAnswerVo"/>
        where student_id = #{studentId} and sheet_id = #{sheetId}
    </select>

    <select id="selectBySheetIdByClassCode" resultMap="BizGuideSheetAnswerResult">
        SELECT a.answer_id, a.sheet_id, a.student_id, a.lesson_id, a.answer_json,
               a.current_page, a.status, a.total_score, a.grading_status,
               a.grading_detail, a.submit_time, a.create_time, a.update_time
        FROM biz_guide_sheet_answer a
        INNER JOIN biz_guide_sheet g ON a.sheet_id = g.sheet_id
        INNER JOIN biz_student s ON a.student_id = s.student_id
        INNER JOIN sys_user u ON s.user_id = u.user_id AND u.dept_id = g.dept_id
        WHERE a.sheet_id = #{sheetId}
        <if test="classCode != null and classCode != ''">
            AND s.entry_year = #{entryYear}
            AND s.class_code = #{classCode}
        </if>
        ORDER BY s.student_no
    </select>

    <select id="selectAvgScore" resultType="java.lang.Double">
        SELECT COALESCE(AVG(a.total_score), 0)
        FROM biz_guide_sheet_answer a
        INNER JOIN biz_guide_sheet g ON a.sheet_id = g.sheet_id
        INNER JOIN biz_student s ON a.student_id = s.student_id
        INNER JOIN sys_user u ON s.user_id = u.user_id AND u.dept_id = g.dept_id
        WHERE a.sheet_id = #{sheetId}
        AND a.status = '2'
        AND a.total_score IS NOT NULL
        <if test="classCode != null and classCode != ''">
            AND s.entry_year = #{entryYear}
            AND s.class_code = #{classCode}
        </if>
    </select>

    <insert id="insertBizGuideSheetAnswer" parameterType="BizGuideSheetAnswer" useGeneratedKeys="true" keyProperty="answerId">
        insert into biz_guide_sheet_answer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sheetId != null">sheet_id,</if>
            <if test="studentId != null">student_id,</if>
            <if test="lessonId != null">lesson_id,</if>
            <if test="answerJson != null">answer_json,</if>
            <if test="currentPage != null">current_page,</if>
            <if test="status != null">status,</if>
            <if test="totalScore != null">total_score,</if>
            <if test="gradingStatus != null">grading_status,</if>
            <if test="gradingDetail != null">grading_detail,</if>
            <if test="submitTime != null">submit_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sheetId != null">#{sheetId},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="lessonId != null">#{lessonId},</if>
            <if test="answerJson != null">#{answerJson},</if>
            <if test="currentPage != null">#{currentPage},</if>
            <if test="status != null">#{status},</if>
            <if test="totalScore != null">#{totalScore},</if>
            <if test="gradingStatus != null">#{gradingStatus},</if>
            <if test="gradingDetail != null">#{gradingDetail},</if>
            <if test="submitTime != null">#{submitTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateBizGuideSheetAnswer" parameterType="BizGuideSheetAnswer">
        update biz_guide_sheet_answer
        <trim prefix="SET" suffixOverrides=",">
            <if test="answerJson != null">answer_json = #{answerJson},</if>
            <if test="currentPage != null">current_page = #{currentPage},</if>
            <if test="status != null">status = #{status},</if>
            <if test="totalScore != null">total_score = #{totalScore},</if>
            <if test="gradingStatus != null">grading_status = #{gradingStatus},</if>
            <if test="gradingDetail != null">grading_detail = #{gradingDetail},</if>
            <if test="submitTime != null">submit_time = #{submitTime},</if>
            update_time = now()
        </trim>
        where answer_id = #{answerId}
        <if test="params.onlyIfNotSubmitted != null and params.onlyIfNotSubmitted">
            and (status is null or status != '2')
        </if>
    </update>

    <delete id="deleteBizGuideSheetAnswerByAnswerIds" parameterType="String">
        delete from biz_guide_sheet_answer where answer_id in
        <foreach item="answerId" collection="array" open="(" separator="," close=")">
            #{answerId}
        </foreach>
    </delete>

    <delete id="deleteBySheetId" parameterType="Long">
        delete from biz_guide_sheet_answer where sheet_id = #{sheetId}
    </delete>

</mapper>
