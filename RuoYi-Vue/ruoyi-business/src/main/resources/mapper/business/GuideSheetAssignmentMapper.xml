<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.GuideSheetAssignmentMapper">

    <resultMap type="BizGuideSheetAssignment" id="BizGuideSheetAssignmentResult">
        <result property="assignmentId" column="assignment_id" />
        <result property="sheetId"      column="sheet_id"      />
        <result property="entryYear"    column="entry_year"    />
        <result property="classCode"    column="class_code"    />
        <result property="deptId"       column="dept_id"       />
        <result property="assignTime"   column="assign_time"   />
    </resultMap>

    <sql id="selectBizGuideSheetAssignmentVo">
        select assignment_id, sheet_id, entry_year, class_code, dept_id, assign_time from biz_guide_sheet_assignment
    </sql>

    <select id="selectBizGuideSheetAssignmentList" parameterType="BizGuideSheetAssignment" resultMap="BizGuideSheetAssignmentResult">
        <include refid="selectBizGuideSheetAssignmentVo"/>
        <where>
            <if test="sheetId != null"> and sheet_id = #{sheetId}</if>
            <if test="deptId != null"> and dept_id = #{deptId}</if>
            <if test="entryYear != null and entryYear != ''"> and entry_year = #{entryYear}</if>
            <if test="classCode != null and classCode != ''"> and class_code = #{classCode}</if>
        </where>
    </select>

    <select id="selectClassCodesBySheetId" parameterType="Long" resultType="String">
        select class_code from biz_guide_sheet_assignment where sheet_id = #{sheetId}
    </select>

    <insert id="insertBizGuideSheetAssignment" parameterType="BizGuideSheetAssignment">
        insert into biz_guide_sheet_assignment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sheetId != null">sheet_id,</if>
            <if test="entryYear != null">entry_year,</if>
            <if test="classCode != null">class_code,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="assignTime != null">assign_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sheetId != null">#{sheetId},</if>
            <if test="entryYear != null">#{entryYear},</if>
            <if test="classCode != null">#{classCode},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="assignTime != null">#{assignTime},</if>
        </trim>
    </insert>

    <insert id="batchInsert">
        insert into biz_guide_sheet_assignment (sheet_id, entry_year, class_code, dept_id, assign_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.sheetId}, #{item.entryYear}, #{item.classCode}, #{item.deptId}, #{item.assignTime})
        </foreach>
    </insert>

    <delete id="deleteBySheetId" parameterType="Long">
        delete from biz_guide_sheet_assignment where sheet_id = #{sheetId}
    </delete>

    <select id="selectCurrentSheetByClass" resultType="Long">
        SELECT gsa.sheet_id
        FROM biz_guide_sheet_assignment gsa
        INNER JOIN biz_guide_sheet gs ON gsa.sheet_id = gs.sheet_id
        WHERE gsa.entry_year = #{entryYear}
          AND gsa.class_code = #{classCode}
          AND gsa.dept_id = #{deptId}
          AND gs.status = '1'
        ORDER BY gsa.assign_time DESC
        LIMIT 1
    </select>

</mapper>
