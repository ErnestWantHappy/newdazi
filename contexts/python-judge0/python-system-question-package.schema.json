{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueyeceping.local/schema/python-system-question-package-v2.json",
  "title": "Python 系统题库 V2 题包",
  "type": "array",
  "minItems": 1,
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "externalId",
      "title",
      "knowledgePoints",
      "difficulty",
      "description",
      "inputDescription",
      "outputDescription",
      "constraints",
      "sampleExplanation",
      "noInput",
      "starterCode",
      "referenceCode",
      "timeLimitSeconds",
      "memoryLimitKb",
      "isPublic",
      "testCases"
    ],
    "properties": {
      "externalId": {
        "type": "string",
        "pattern": "^PYV2-[0-9]{3}$"
      },
      "title": {
        "type": "string",
        "minLength": 2,
        "maxLength": 30
      },
      "knowledgePoints": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      },
      "difficulty": {
        "enum": ["SIMPLE", "MEDIUM", "HARD"]
      },
      "description": {
        "type": "string",
        "minLength": 20
      },
      "inputDescription": {
        "type": "string",
        "minLength": 4
      },
      "outputDescription": {
        "type": "string",
        "minLength": 4
      },
      "constraints": {
        "type": "string",
        "minLength": 4
      },
      "sampleExplanation": {
        "type": "string"
      },
      "noInput": {
        "type": "boolean"
      },
      "starterCode": {
        "type": "string",
        "maxLength": 2000
      },
      "referenceCode": {
        "type": "string",
        "minLength": 3,
        "maxLength": 20000
      },
      "timeLimitSeconds": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 10
      },
      "memoryLimitKb": {
        "type": "integer",
        "minimum": 16384,
        "maximum": 524288
      },
      "isPublic": {
        "const": true
      },
      "testCases": {
        "type": "array",
        "minItems": 6,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseName",
            "inputText",
            "expectedOutput",
            "isPublic",
            "scoreWeight",
            "orderNum"
          ],
          "properties": {
            "caseName": {
              "type": "string",
              "minLength": 2,
              "maxLength": 50
            },
            "inputText": {
              "type": "string",
              "maxLength": 50000
            },
            "expectedOutput": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            },
            "isPublic": {
              "type": "boolean"
            },
            "scoreWeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "orderNum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      }
    }
  }
}
